/* ClaudeCompatible.swift */
"~/.qwen/settings.json has \"disableAllHooks\": true, so Qwen Code runs no hooks." = "~/.qwen/settings.json에 \"disableAllHooks\": true가 설정되어 있어 Qwen Code가 훅을 실행하지 않습니다.";
